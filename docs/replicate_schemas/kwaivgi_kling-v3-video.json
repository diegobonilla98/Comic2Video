{
  "model": "kwaivgi/kling-v3-video",
  "version": "53c71d6674222d4cd8aa5ec1c03e42720dfa8c1a67a45a182c5ffa5ccc2bc023",
  "schema": {
    "info": {
      "title": "Cog",
      "version": "0.23.1"
    },
    "paths": {},
    "openapi": "3.0.2",
    "components": {
      "schemas": {
        "mode": {
          "enum": [
            "standard",
            "pro",
            "4k"
          ],
          "type": "string",
          "title": "mode",
          "description": "An enumeration."
        },
        "Input": {
          "type": "object",
          "title": "Input",
          "required": [
            "prompt"
          ],
          "properties": {
            "mode": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/mode"
                }
              ],
              "default": "pro",
              "x-order": 4,
              "description": "'standard' generates 720p, 'pro' generates 1080p, '4k' generates 4K."
            },
            "prompt": {
              "type": "string",
              "title": "Prompt",
              "x-order": 0,
              "description": "Text prompt for video generation. Max 2500 characters."
            },
            "duration": {
              "type": "integer",
              "title": "Duration",
              "default": 5,
              "maximum": 15,
              "minimum": 3,
              "x-order": 6,
              "description": "Video duration in seconds."
            },
            "end_image": {
              "type": "string",
              "title": "End Image",
              "format": "uri",
              "default": null,
              "x-order": 3,
              "nullable": true,
              "description": "Last frame image. Requires start_image. Supports .jpg/.jpeg/.png, max 10MB, min 300px."
            },
            "start_image": {
              "type": "string",
              "title": "Start Image",
              "format": "uri",
              "default": null,
              "x-order": 2,
              "nullable": true,
              "description": "First frame image. Supports .jpg/.jpeg/.png, max 10MB, min 300px, aspect ratio 1:2.5 to 2.5:1."
            },
            "aspect_ratio": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/aspect_ratio"
                }
              ],
              "default": "16:9",
              "x-order": 5,
              "description": "Aspect ratio. Ignored when start_image is provided."
            },
            "multi_prompt": {
              "type": "string",
              "title": "Multi Prompt",
              "default": null,
              "x-order": 8,
              "nullable": true,
              "description": "JSON array of shot definitions for multi-shot mode. Each shot: {\"prompt\": \"...\", \"duration\": N}. Max 6 shots, min 1s per shot, total must equal duration."
            },
            "generate_audio": {
              "type": "boolean",
              "title": "Generate Audio",
              "default": false,
              "x-order": 7,
              "description": "Generate native audio for the video."
            },
            "negative_prompt": {
              "type": "string",
              "title": "Negative Prompt",
              "default": "",
              "x-order": 1,
              "description": "Things you do not want to see in the video. Max 2500 characters."
            }
          }
        },
        "Output": {
          "type": "string",
          "title": "Output",
          "format": "uri"
        },
        "Status": {
          "enum": [
            "starting",
            "processing",
            "succeeded",
            "canceled",
            "failed"
          ],
          "type": "string",
          "title": "Status",
          "description": "An enumeration."
        },
        "aspect_ratio": {
          "enum": [
            "16:9",
            "9:16",
            "1:1"
          ],
          "type": "string",
          "title": "aspect_ratio",
          "description": "An enumeration."
        },
