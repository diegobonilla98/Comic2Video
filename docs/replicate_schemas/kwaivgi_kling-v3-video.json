              "type": "string",
              "title": "Error"
            },
            "input": {
              "$ref": "#/components/schemas/Input"
            },
            "output": {
              "$ref": "#/components/schemas/Output"
            },
            "status": {
              "type": "string",
              "title": "Status"
            },
            "metrics": {
              "type": "object",
              "title": "Metrics"
            },
            "version": {
              "type": "string",
              "title": "Version"
            },
            "created_at": {
              "type": "string",
              "title": "Created At",
              "format": "date-time"
            },
            "started_at": {
              "type": "string",
              "title": "Started At",
              "format": "date-time"
            },
            "completed_at": {
              "type": "string",
              "title": "Completed At",
              "format": "date-time"
            }
          }
        },
        "HTTPValidationError": {
          "type": "object",
          "title": "HTTPValidationError",
          "properties": {
            "detail": {
              "type": "array",
